{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "jsx": "preserve",
    "jsxImportSource": "xzo",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@xzo/router": ["../../packages/router/src/index.ts"]
    }
  },
  "include": ["./**/*", "../../src/jsx.d.ts", "../../src/stylis.d.ts"]
}
