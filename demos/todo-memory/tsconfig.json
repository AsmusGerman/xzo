{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2020", "ES2021", "DOM"],
    "jsx": "preserve",
    "jsxImportSource": "xzo",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "xzo": ["../../src/index.ts"],
      "xzo/dom": ["../../src/dom/index.ts"],
      "xzo/jsx-runtime": ["../../src/jsx-runtime.ts"],
      "xzo/jsx-dev-runtime": ["../../src/jsx-dev-runtime.ts"]
    }
  },
  "include": [".", "../../src/jsx.d.ts", "../../src/stylis.d.ts"]
}
